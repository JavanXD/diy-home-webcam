# Copy outside the repo (mode 600). Install on the Pi as /etc/webcam-pipeline/env
# (mode 640, owner root, group webcam). Never commit the filled file.
#
# Works for Cloudflare R2 and any S3-compatible API (MinIO, AWS S3, Wasabi, B2, …).
# Variable names follow boto3 / AWS SDK convention — see docs/diy/PUBLISH.md.
#
# Cloudflare R2: dashboard → R2 → Manage R2 API Tokens → Object Read & Write
# on this bucket only. You may set CLOUDFLARE_ACCOUNT_ID and omit AWS_ENDPOINT_URL.

CLOUDFLARE_ACCOUNT_ID=replace-me
R2_BUCKET=example-webcam
S3_BUCKET=example-webcam
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto
# AWS_S3_FORCE_PATH_STYLE=true
