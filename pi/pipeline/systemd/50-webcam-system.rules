// Let the webcam service reboot / power off the Pi and restart its own stack
// from the LAN Pipeline home System card. No unbound shell — fixed actions only.
// Install: sudo cp this file to /etc/polkit-1/rules.d/ (provision and deploy do that).
polkit.addRule(function(action, subject) {
  if (subject.user !== "webcam") {
    return null;
  }
  var id = action.id || "";
  if (
    id === "org.freedesktop.login1.reboot" ||
    id === "org.freedesktop.login1.reboot-multiple-sessions" ||
    id === "org.freedesktop.login1.reboot-ignore-inhibit" ||
    id === "org.freedesktop.login1.power-off" ||
    id === "org.freedesktop.login1.power-off-multiple-sessions" ||
    id === "org.freedesktop.login1.power-off-ignore-inhibit"
  ) {
    return polkit.Result.YES;
  }
  if (id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    var allowed =
      unit === "webcam-camera.service" ||
      unit === "webcam-pipeline.service" ||
      unit === "nginx.service";
    if (allowed && (verb === "restart" || verb === "try-restart" || verb === "reload")) {
      return polkit.Result.YES;
    }
  }
  return null;
});
