# OS disk layout. SD-only installs can ignore the NVMe scripts.
# Apply: sudo ./pi/scripts/apply-bootloader.sh
# NVMe first, then SD, then USB, then restart.

BOOT_ORDER=0xf416

SRC_DISK=/dev/mmcblk0
DST_DISK=/dev/nvme0n1

EXPECT_ROOT_DISK=nvme0n1
EXPECT_BOOT_DISK=nvme0n1

REDIRECT_TO_PORT=8080
HTTP_REDIRECT_SITE=webcam-port-redirect
