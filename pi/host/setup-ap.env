# Setup Wi-Fi access point (first boot / no home Wi-Fi configured).
# Copied once to /etc/webcam-setup-ap.env by provision. Edit on-device if needed.
#
# Security (home DIY): WPA2 with a published temporary password. Anyone nearby
# who knows this password can join the setup AP and change Wi-Fi settings.
# After Setup joins home Wi-Fi, the AP is torn down and
# /var/lib/webcam-pipeline/setup-ap.disabled is written automatically.
# Operator forever-off: sudo touch /etc/webcam-pipeline/setup-ap.disabled
# Or: sudo systemctl disable --now webcam-setup-ap.service
# Details: docs/diy/SECURITY.md

SETUP_AP_ENABLED=yes

# SSID phone/laptop joins for captive setup
SETUP_AP_SSID=Webcam-Setup

# Temporary WPA2 password (documented in docs/diy/BUILD.md). Change on-device if you like.
SETUP_AP_PASSWORD=webcam-setup

# NetworkManager connection profile name (not the SSID)
SETUP_AP_CONNECTION=webcam-setup-ap

# Gateway clients use while on the AP (NetworkManager shared mode default)
SETUP_AP_GATEWAY=10.42.0.1

# Seconds to wait after boot before deciding (lets Imager/cloud-init Wi-Fi settle)
SETUP_AP_SETTLE_SECONDS=25
