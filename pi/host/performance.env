# Headless tuning. The copy in pi/host/performance.env is the same idea
# with comments for this deployment's hostname. Apply:
#   sudo ./pi/scripts/apply-host-performance.sh

DEFAULT_TARGET=multi-user.target
VM_SWAPPINESS=10
JOURNAL_SYSTEM_MAX_USE=50M

DISABLE_SERVICES=(
  lightdm.service
  wayvnc-control.service
  cups.service
  cups.socket
  cups.path
  bluetooth.service
  nfs-blkmap.service
  rpcbind.service
  rpcbind.socket
  accounts-daemon.service
  glamor-test.service
  rp1-test.service
)
