# DHCP on Wi-Fi and Ethernet. Do not put an SSID or passphrase here.
# Apply: sudo ./pi/scripts/apply-network.sh

IPV4_METHOD=auto

# cloudflare = 1.1.1.1 ; dhcp = whatever the router advertises
DNS_MODE=dhcp
DNS_V4=1.1.1.1,1.0.0.1
DNS_V6=2606:4700:4700::1111,2606:4700:4700::1001
IGNORE_AUTO_DNS=no

WIFI_AUTOCONNECT=yes
WIFI_AUTOCONNECT_PRIORITY=10
ETH_AUTOCONNECT=yes
ETH_AUTOCONNECT_PRIORITY=5
WIFI_ROUTE_METRIC=100
ETH_ROUTE_METRIC=300

IPV4_MAY_FAIL=yes
IPV6_MAY_FAIL=yes
