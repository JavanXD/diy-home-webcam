# pi-gen config (used by image/build-with-pi-gen.sh and documented for CI).
# https://github.com/RPi-Distro/pi-gen

IMG_NAME='home-webcam'
RELEASE='bookworm'
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL='6'
ENABLE_SSH=1
TARGET_HOSTNAME='home-webcam'
FIRST_USER_NAME='pi'
# Bootstrap only until image first-boot rotates a unique per-device password
# (written to /boot/firmware/webcam-setup.txt). Required by pi-gen when
# DISABLE_FIRST_BOOT_USER_RENAME=1. Prefer Imager SSH public key; when
# authorized_keys is present, first-boot disables password SSH. Never bake
# private keys or R2 credentials into the image (see docs/diy/SECURITY.md).
FIRST_USER_PASS='webcam-setup'
DISABLE_FIRST_BOOT_USER_RENAME=1
# Do not bake Wi-Fi into the image; setup AP or Imager handles that.
STAGE_LIST="stage0 stage1 stage2 ./stage-webcam"
